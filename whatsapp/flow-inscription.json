{
  "version": "7.3",
  "screens": [
    {
      "id": "INSCRIPTION",
      "title": "نحب نسجل",
      "terminal": true,
      "success": true,
      "data": {
        "intro": { "type": "string", "__example__": "كمل هالمعلومات باش نسجلوك في الدورة الجاية 👇" },
        "need_age": { "type": "boolean", "__example__": true },
        "need_situation": { "type": "boolean", "__example__": true },
        "need_plan": { "type": "boolean", "__example__": true }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.intro}" },
          {
            "type": "TextInput",
            "name": "age",
            "label": "العمر",
            "input-type": "number",
            "visible": "${data.need_age}",
            "required": "${data.need_age}"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "situation",
            "label": "شنوة الوضعية متاعك؟",
            "visible": "${data.need_situation}",
            "required": "${data.need_situation}",
            "data-source": [
              { "id": "نخدم", "title": "نخدم" },
              { "id": "نقرا", "title": "نقرا" },
              { "id": "مانيش نخدم", "title": "مانيش نخدم" },
              { "id": "فريلانس", "title": "فريلانس" },
              { "id": "حاجة أخرى", "title": "حاجة أخرى" }
            ]
          },
          {
            "type": "RadioButtonsGroup",
            "name": "formule",
            "label": "كيفاش تحب تخلص؟",
            "visible": "${data.need_plan}",
            "required": "${data.need_plan}",
            "data-source": [
              { "id": "total", "title": "مرة وحدة" },
              { "id": "monthly", "title": "على أقساط (كل شهر)" }
            ]
          },
          {
            "type": "Footer",
            "label": "أكد التسجيل",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "age": "${form.age}",
                "situation": "${form.situation}",
                "formule": "${form.formule}"
              }
            }
          }
        ]
      }
    }
  ]
}
