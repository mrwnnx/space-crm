RESEND_API_KEY=
EMAIL_FROM="Space Academy <noreply@spaceacademy.com>"

# Twilio (SMS + WhatsApp) — https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+14155238886

# Cron secret (to protect /api/cron/sequences)
CRON_SECRET=change-me-cron-secret

# Supabase Auth — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
